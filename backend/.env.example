DATABASE_URL=jdbc:postgresql://db.xxxx.supabase.co:5432/postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-password
# CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000

# OpenRouter — single key, route to any model (Gemini, GPT-4o, DeepSeek, etc.) via model id
OPENROUTER_API_KEY=

LLM_FAST_MODEL=google/gemini-2.0-flash-001
LLM_QUALITY_MODEL=google/gemini-2.0-flash-001

OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Style Communicator
