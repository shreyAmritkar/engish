DATABASE_URL=jdbc:postgresql://localhost:5432/stylecommunicator
DB_USER=postgres
DB_PASSWORD=postgres
CORS_ORIGINS=http://localhost:3000

# OpenRouter only (recommended) — Gemini/DeepSeek/etc. via model id, no separate Google key
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=

# Gemini through OpenRouter (avoid free :free tiers if you hit 429)
LLM_FAST_MODEL=google/gemini-2.0-flash-001
LLM_QUALITY_MODEL=google/gemini-2.0-flash-001

OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Style Communicator

# Optional: direct Google API (legacy) — set LLM_PROVIDER=gemini and GEMINI_API_KEY
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# LLM_FAST_MODEL=gemini-1.5-flash
# LLM_QUALITY_MODEL=gemini-1.5-pro
