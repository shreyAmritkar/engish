# ============ Database Configuration ============
DATABASE_URL=jdbc:postgresql://localhost:5432/style_communicator
DB_USER=postgres
DB_PASSWORD=your_password_here
PORT=8080

# ============ JWT & Security ============
JWT_SECRET=change-me-in-production-use-openssl-rand-base64-48-or-longer
JWT_EXPIRATION_MS=86400000

# ============ CORS Configuration ============
CORS_ORIGINS=http://localhost:3000

# ============ LLM Configuration ============
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_FAST_MODEL=google/gemma-4-26b-a4b-it:free
LLM_QUALITY_MODEL=google/gemma-4-31b-it:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Style Communicator

# ============ Cookie Configuration ============
# Set to true for HTTPS (production)
# Set to false for HTTP (development)
COOKIE_SECURE=false

# ============ Feature Flags ============
DAILY_SESSION_CAP=10
STYLE_CACHE_TTL_MINUTES=60
SIMILARITY_THRESHOLD=0.85
